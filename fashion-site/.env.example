# Client-side (baked into the bundle at build time — must never hold a secret)
VITE_SITE_ORIGIN=            # e.g. https://nocturnal.example — canonical/OG/sitemap are omitted while unset
VITE_ENQUIRY_EMAIL=          # public contact address for the enquiry-failure mailto fallback

# Server-side only. Set these as Cloudflare Pages environment variables, NOT here.
# SUPABASE_SERVICE_ROLE_KEY must be marked "Encrypted" in the Pages dashboard.
#
#   npx wrangler pages secret put SUPABASE_SERVICE_ROLE_KEY
#   npx wrangler pages secret put SUPABASE_URL
#   npx wrangler pages secret put ENQUIRY_IP_SALT
#   npx wrangler pages secret put ENQUIRY_PROJECT_ID
