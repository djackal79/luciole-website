# Copy to golf-sim/.env and adjust. Every key is optional.

# --- server ---------------------------------------------------------------
GOLFSIM_HOST=0.0.0.0
GOLFSIM_PORT=8000

# --- storage --------------------------------------------------------------
GOLFSIM_DATA_ROOT=./data
# Blank derives one on boot, e.g. 20260906-morning
GOLFSIM_SESSION_ID=

# --- pairing --------------------------------------------------------------
GOLFSIM_PAIR_WINDOW_MS=3000
# Grace after a shot closes during which a straggler still joins it instead of
# opening a phantom shot. Set to 0 for strict window behaviour.
GOLFSIM_LATE_ATTACH_MS=5000

# --- GSPro Open Connect v1 listener ---------------------------------------
# GSPro also binds 921, so only one can listen at a time. Practice sessions
# point Square here; course play points it at GSPro. Toggle at runtime with
# POST /api/listeners/gspro?enabled=false -- no restart needed.
GOLFSIM_GSPRO_ENABLED=true
GOLFSIM_GSPRO_HOST=127.0.0.1
GOLFSIM_GSPRO_PORT=921
# Pass-through: play GSPro while this app records. Run the listener on 922,
# point the bridge's custom IP/Port there, and leave GSPro on 921.
#   GOLFSIM_GSPRO_PORT=922
#   GOLFSIM_GSPRO_FORWARD_ENABLED=true
#   GOLFSIM_GSPRO_FORWARD_HOST=127.0.0.1
#   GOLFSIM_GSPRO_FORWARD_PORT=921

# --- media defaults -------------------------------------------------------
# Used when the ingesting client does not supply them. capture_fps cannot be
# probed: 240 fps footage in a 30 fps container probes as 30.
GOLFSIM_BODY_SWING_CAMERA=face_on
GOLFSIM_BODY_SWING_CAPTURE_FPS=30
GOLFSIM_BODY_SWING_CONTAINER_FPS=30
GOLFSIM_IMPACT_CAMERA=impact
GOLFSIM_IMPACT_CAPTURE_FPS=240
GOLFSIM_IMPACT_CONTAINER_FPS=30

# --- Kinovea fallback watcher ---------------------------------------------
# Prefer Kinovea's Automation hook posting to /api/ingest/body_swing. This
# watcher is only for clips that appear without a notification.
GOLFSIM_KINOVEA_WATCH_ENABLED=false
# Windows example: GOLFSIM_KINOVEA_EXPORT_DIR=C:/Users/you/Videos/Kinovea
GOLFSIM_KINOVEA_EXPORT_DIR=./data/kinovea_export
# The watcher only sees a file once encoding finished, later than the strike.
# Back-dates its receipt stamp so pairing still lands. See README calibration.
GOLFSIM_KINOVEA_LAG_MS=0

# --- ball flight model ----------------------------------------------------
# The monitor measures launch conditions only, so carry, apex and descent are
# modelled into telemetry.flight. telemetry.distance stays null: it means
# measured. Set the air your bay actually sits in.
GOLFSIM_FLIGHT_MODEL_ENABLED=true
GOLFSIM_FLIGHT_ALTITUDE_M=0
GOLFSIM_FLIGHT_TEMPERATURE_C=20

# --- pose extraction (optional) -------------------------------------------
# Needs requirements-pose.txt and one model download:
#   python scripts/fetch_pose_model.py
GOLFSIM_POSE_ENABLED=true
GOLFSIM_POSE_MODEL_PATH=./models/pose_landmarker_lite.task
# Caps sampling. Pose at 30 Hz is finer than any swing metric needs, so a
# 60 fps down-the-line clip is halved for nothing lost.
GOLFSIM_POSE_MAX_FPS=30
GOLFSIM_POSE_MIN_CONFIDENCE=0.5
GOLFSIM_POSE_QUEUE_SIZE=8

# --- store-and-forward capture (stock camera + Android watcher) -----------
# The stock-camera path uploads a clip 4-9s after the strike, so receipt
# stamping pairs it to the NEXT swing. Turn both of these on when using
# android/impact-watcher; leave them alone for any live-trigger capture.
#   GOLFSIM_IMPACT_TRUST_TRIGGER_TS=true
#   GOLFSIM_LATE_ATTACH_MS=30000
# A trigger_ts further than this from now is a broken clock, not upload lag.
GOLFSIM_TRIGGER_TS_MAX_SKEW_MS=30000

# --- security -------------------------------------------------------------
# Leave empty on a trusted LAN; when set, ingest requires X-Golfsim-Token.
GOLFSIM_INGEST_TOKEN=
