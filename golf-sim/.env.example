# Copy to golf-sim/.env and adjust. Every key is optional.

# --- server ---------------------------------------------------------------
GOLFSIM_HOST=0.0.0.0
GOLFSIM_PORT=8000

# --- storage --------------------------------------------------------------
GOLFSIM_DATA_ROOT=./data
# Point this at the folder Kinovea is configured to export into.
# Windows example: GOLFSIM_KINOVEA_EXPORT_DIR=C:/Users/you/Videos/Kinovea
GOLFSIM_KINOVEA_EXPORT_DIR=./data/kinovea_export

# --- pairing --------------------------------------------------------------
GOLFSIM_PAIR_WINDOW_SECONDS=3.0
GOLFSIM_SETTLE_SECONDS=12.0
GOLFSIM_LATE_ATTACH_SECONDS=90.0
GOLFSIM_EXPECTED_SOURCES=["swing_video","impact_video","telemetry"]

# --- Kinovea timestamp derivation ----------------------------------------
# mtime | filename | mtime_minus_duration   (see README "Calibration")
GOLFSIM_KINOVEA_TIMESTAMP_MODE=mtime
GOLFSIM_KINOVEA_WRITE_LAG_SECONDS=0.0
GOLFSIM_KINOVEA_IMPACT_OFFSET_SECONDS=0.0
GOLFSIM_INGEST_EXISTING_ON_START=false

# --- security -------------------------------------------------------------
# Leave empty on a trusted LAN; when set, ingest requires X-Golfsim-Token.
GOLFSIM_INGEST_TOKEN=
